definition {

	@summary = "Sign out of Liferay Portal"
	macro signOut {
		Navigator.openURL();

		UserBar.signOut();
	}

	macro signOutOfSpecificURL {
		Navigator.openSpecificURL(url = "${url}");

		UserBar.signOut();
	}

	macro signOutViaURL {
		var portalURL = PropsUtil.get("portal.url");

		Navigator.openSpecificURL(url = "${portalURL}/c/portal/logout");
	}

}