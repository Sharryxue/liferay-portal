<html>
<head>
<title>LRLogin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRLogin</td></tr>
</thead>
<tbody>
<tr>
	<td>SIGN_IN_LINK</td>
	<td>//span[contains(@class,'sign-in')]/a</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FILED</td>
	<td>//div[label[contains(.,'Email Address')]]/input</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FILED</td>
	<td>//div[label[contains(.,'Password')]]/input</td>
	<td></td>
</tr>
<tr>
	<td>REMBERME_FILED</td>
	<td>//label[contains(.,'Remember Me')]/input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'${key_buttonName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>