@component-name = "portal-web-smoke"
definition {

	property testray.main.component.name = "Smoke";

	@description = "Ensure that the super admin can login successful."
	@priority = "5"
	test SuperAdminLogin {
		MyFirstMacro.login(
			userEmailAddress = "test@liferay.com",
			userPassword = "test");
	
		MyFirstMacro.viewLogin(userFullName = "Test Test");

		User.logoutPG();

		MyFirstMacro.login(
			userEmailAddress = "test@liferay.com",
			userPassword = "test");
	
		MyFirstMacro.viewLogin(userFullName = "Test Test");

		User.logoutPG();
	}

	test SuperAdminLogin1 {
		for (var userEmailAddress : list "user1,user2,user3") {
			MyFirstMacro.login(
				userEmailAddress = "${userEmailAddress}@liferay.com",
				userPassword = "test");

			MyFirstMacro.viewLogin(userFullName = "${userEmailAddress}");

			User.logoutPG();
		}
	}
}
