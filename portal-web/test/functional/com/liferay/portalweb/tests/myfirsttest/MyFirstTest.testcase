@component-name = "portal-web-smoke"
definition {

	property testray.main.component.name = "Smoke";

	@description = "Ensure that the super admin can login successful."
	@priority = "5"
	test SuperAdminLogin{
		MyFirstMacro.login(
			userEmailAddress = "test@liferay.com",
			userPassword = "test");
	
		MyFirstMacro.viewLogin(userFullName = "Test Test");

		User.logoutPG();

		MyFirstMacro.login(
			userEmailAddress = "test@liferay.com",
			userPassword = "test");
	
		MyFirstMacro.viewLogin(userFullName = "Test Test");

		User.logoutPG();		
	}
	
	test SuperAdminLogin1{
		for (var userEmailAddress : list "user1@liferay.com,user2@liferay.com,user3@liferay.com") {
			MyFirstMacro.login(
				userEmailAddress = "${userEmailAddress}",
				userPassword = "test");

			User.logoutPG();
}
	}	
}
